APP_BASE_URL=http://localhost:5173

# Caption generation (Anthropic Claude)
# supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_KEY=

# Instagram posting via Make.com or Zapier webhook (no Graph API tokens needed)
#
# Make.com (free — 1,000 ops/month):  https://make.com
#   1. New Scenario → Webhooks (Custom webhook) — copy the URL
#   2. Add action: Instagram for Business → Create a Photo Post
#      Image URL: {{1.imageUrl}}   Caption: {{1.caption}}
#   3. Turn scenario ON
#
# Zapier (free — 100 tasks/month):  https://zapier.com
#   1. New Zap → Trigger: Webhooks by Zapier (Catch Hook) — copy the URL
#   2. Action: Instagram for Business → Create Post
#      Media URL: {{imageUrl}}   Caption: {{caption}}
#   3. Publish Zap
#
# Then run:
# supabase secrets set INSTAGRAM_WEBHOOK_URL=https://hook.eu2.make.com/xxxx
INSTAGRAM_WEBHOOK_URL=
