# Development defaults point at a LOCAL Supabase stack (`supabase start`), never
# a live club. Each deployment sets its own values in its hosting environment.
# Never put a service-role or secret key in any VITE_ variable.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Push notifications (Web Push / VAPID)
# Generate with: npx web-push generate-vapid-keys
# Then run: supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=... VAPID_SUBJECT=mailto:admin@yourclub.com
VITE_VAPID_PUBLIC_KEY=
# Optional public club website; the CRM runs independently of this site.
VITE_CLUB_WEBSITE_URL=
# Google Maps JavaScript API key with Places API (New) enabled.
VITE_GOOGLE_MAPS_API_KEY=
# Optional regional hint for pitch-name search when Google Places is unavailable.
VITE_MAP_SEARCH_REGION=
# Optional one-tap home venue and aliases, separated with | characters.
VITE_CLUB_HOME_VENUE_NAME=
VITE_CLUB_HOME_VENUE_ADDRESS=
VITE_CLUB_HOME_VENUE_ALIASES=
VITE_CLUB_HOME_VENUE_LAT=
VITE_CLUB_HOME_VENUE_LNG=

# ClubOS mode: standalone (default, one club per deployment), directory (club
# finder only, no backend) or multi (members choose a club; one app, each club
# keeps its own backend). See ARCHITECTURE.md.
VITE_CLUBOS_MODE=standalone
# Operator-managed club registry (JSON array). See ARCHITECTURE.md for the schema.
# Only public anon/publishable keys are accepted; the build rejects others.
VITE_CLUBOS_REGISTRY_JSON=
# Optional comma-separated, operator-approved backend hosts (Supabase custom domains).
VITE_CLUBOS_BACKEND_HOSTS=
# Optional ClubOS control plane (directory and multi modes only; ignored in
# standalone). The app reads active clubs from its public clubs_public view,
# validates them like the bundled registry, and falls back to the last good copy
# on the device, then VITE_CLUBOS_REGISTRY_JSON. Public anon key only.
VITE_CLUBOS_CONTROL_PLANE_URL=
VITE_CLUBOS_CONTROL_PLANE_ANON_KEY=
# Legacy names from the first multi-club branch, still honoured.
VITE_CLUB_DIRECTORY_JSON=
VITE_CLUB_DIRECTORY_ONLY=false
# Optional public website starter (public configuration only)
VITE_CLUB_PUBLIC_SITE_JSON=

# Guest camp checkout (/pay/camp, "Copy guest pay link" in Admin > Billing).
# Set to true only after the club backend has the guest_checkout_registrations
# table and the create-guest-checkout-session Edge Function, and the flow has
# been verified in Stripe test mode.
VITE_GUEST_CHECKOUT_ENABLED=false
